{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShare",
  "version": "2.0.9",
  "identifier": "com.screenshare.desktop",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenShare",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "ScreenShare",
    "copyright": "Copyright © 2026 ScreenShare",
    "shortDescription": "Compartilhamento de tela em grupos privados",
    "category": "SocialNetworking",
    "homepage": "https://github.com/Ruthraas/Screen-Share"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["screenshare"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNTQ4NkRDMEJDM0REMDgKUldRSTNjTUwzSVpVVUE5VlQ5cEd0VlltT1VYc3d0Z0ZITm5yVFRRbjB0aDZhMTVOTXZMQUorQ0wK",
      "endpoints": [
        "https://github.com/Ruthraas/Screen-Share/releases/latest/download/latest.json"
      ]
    }
  }
}
