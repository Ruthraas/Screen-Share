{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShare",
  "version": "1.0.0",
  "identifier": "com.screenshare.desktop",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenShare",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["screenshare"]
      }
    }
  }
}
