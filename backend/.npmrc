# Segurança geral: pula scripts install/postinstall de toda a árvore de
# dependências, por padrão (motivo original, issue #58, já não existe mais
# — better-sqlite3 saiu na migração pro Turso, issue #82). Verificado de
# novo em 2026-09-14, pós-migração: nenhum pacote tem binding.gyp; o único
# pacote com postinstall na árvore (esbuild, transitivo do tsx) já resolve
# o binário certo via optionalDependencies por plataforma, sem depender do
# script pra funcionar — suíte de testes roda normalmente com isto ligado.
# Se uma dependência nova de verdade precisar de um postinstall pra
# funcionar, isto vai quebrá-la silenciosamente; reavalie esta linha nesse
# caso.
ignore-scripts=true

# Falha com mensagem clara em vez de instalar silenciosamente numa versão
# de Node fora do suportado (ver "engines" em package.json e .nvmrc).
engine-strict=true
