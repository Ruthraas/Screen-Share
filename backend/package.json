{
  "name": "screenshare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço remoto do ScreenShare (grupos, convites, presença, TURN, sinalização). Ver docs/backend/ARQUITETURA.md.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrateCli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e-manual": "node scripts/testar-fluxo-completo.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.21.3"
  }
}
