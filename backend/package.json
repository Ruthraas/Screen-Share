{
  "name": "screenshare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço remoto do ScreenShare (grupos, convites, presença, TURN, sinalização). Ver docs/backend/ARQUITETURA.md.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrateCli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e-manual": "node scripts/testar-fluxo-completo.mjs",
    "test:capacidade-signaling": "node scripts/teste-capacidade-signaling.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
