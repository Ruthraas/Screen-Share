# Copie para .env e preencha com valores reais. Nunca commitar o .env.
# Ver docs/backend/ARQUITETURA.md para o papel de cada variável.

# --- servidor ---
HOST=0.0.0.0
PORT=8787

# --- banco (SQLite, issue #31) ---
# Caminho do arquivo do banco. Use ":memory:" só em testes.
DATABASE_PATH=./data/screenshare.db

# --- autenticação própria (issue #30 — Firebase Auth não é mais usado) ---
# Assina access token + o "state" do OAuth. >=32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=
# Entra no hash de senha (scrypt) além do salt. >=16 caracteres, nunca igual
# ao SESSION_SIGNING_SECRET.
PASSWORD_PEPPER=
# URL pública deste backend — usada pra montar o redirect_uri enviado a
# cada provedor OAuth. Precisa ser EXATAMENTE a mesma URL cadastrada na
# console de cada provedor (Google/GitHub/Discord), só troca o domínio por
# ambiente (dev/produção).
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8787
# Pra onde o cliente volta depois do fluxo OAuth (sucesso ou erro) — o
# frontend lê o resultado num fragmento da URL (#access_token=...&...).
# Existem DOIS destinos possíveis ao mesmo tempo, escolhidos pelo `?target=`
# que o cliente já manda em /start (browser = página de fallback do
# navegador em dev; desktop = deep link do app Tauri empacotado). Ambos têm
# default: ajuste só se a origem/esquema mudar.
OAUTH_FRONTEND_REDIRECT_URL_BROWSER=http://127.0.0.1:5173/oauth.html
OAUTH_FRONTEND_REDIRECT_URL_DESKTOP=screenshare://oauth-callback

# Credenciais por provedor — opcionais (sem elas, aquele provedor responde
# 404 em vez de travar o boot). Nunca commitar valores reais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- sinalização (issue #37/#38) ---
SIGNALING_PATH=/ws

# --- TURN (issue #40/#41) ---
# Cloudflare Realtime TURN (serviço gerenciado — decisão registrada em
# docs/backend/ARQUITETURA.md). Crie uma "TURN Key" no dashboard da
# Cloudflare (Realtime > TURN); TURN_KEY_ID é o "App ID"/"Turn Key ID"
# mostrado lá (não é segredo, entra na URL da API), TURN_KEY_API_TOKEN é o
# "API Token" (segredo de servidor, nunca enviar ao cliente).
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# --- CORS (issue #59) ---
# Lista separada por vírgula. Padrão (se omitido) já cobre o dev server do
# Vite (vite.config.ts) e o WebView do Tauri 2 empacotado no Windows — os
# dois esquemas (http/https) de tauri.localhost, porque o WebView2 manda
# um ou outro dependendo da versão/config (issue #69).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,https://tauri.localhost,http://tauri.localhost

# --- limites de uso / anti-abuso (issue #43) ---
# Todas opcionais — os valores abaixo já são o default se omitidas. Uma
# janela só compartilhada por todos os limites de HTTP; WS_CONNECT usa a
# mesma janela mas é enforçado por um limitador próprio (não é uma rota
# HTTP comum, é o handshake de /ws), ver src/signaling/connectRateLimiter.ts.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OAUTH_MAX=20
RATE_LIMIT_SESSION_MAX=30
RATE_LIMIT_TURN_MAX=10
RATE_LIMIT_WS_CONNECT_MAX=20
# Corpo máximo de requisição HTTP, em bytes — default é o mesmo já
# embutido no Fastify (1 MiB), só explicitado.
MAX_BODY_BYTES=1048576
