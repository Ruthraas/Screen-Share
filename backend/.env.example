# Copie para .env e preencha com valores reais. Nunca commitar o .env.
# Ver docs/backend/ARQUITETURA.md para o papel de cada variável.

# --- servidor ---
HOST=0.0.0.0
PORT=8787

# --- banco (SQLite, issue #31) ---
# Caminho do arquivo do banco. Use ":memory:" só em testes.
DATABASE_PATH=./data/screenshare.db

# --- autenticação (Firebase Auth, issue #30) ---
# Caminho para o JSON da service account do Firebase Admin. Nunca commitar
# o arquivo apontado aqui.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Alternativa ao arquivo acima: o próprio JSON em uma única linha (útil em
# ambientes de deploy que só aceitam variáveis de ambiente). Se ambos forem
# definidos, FIREBASE_SERVICE_ACCOUNT_JSON tem prioridade.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- sinalização (issue #37/#38) ---
SIGNALING_PATH=/ws

# --- TURN (issue #40/#41) ---
TURN_HOST=turn.screenshare.example
TURN_SECRET=segredo-hmac-do-servidor-turn

# --- CORS (issue #59) ---
# Lista separada por vírgula. Padrão (se omitido) já cobre o dev server do
# Vite (vite.config.ts) e o WebView do Tauri 2 empacotado no Windows.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,https://tauri.localhost
